{
  "name": "elearning-backend",
  "version": "1.0.0",
  "description": "E-Learning Platform Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "set NODE_ENV=production && node src/server.js",
    "dev": "set NODE_ENV=development && set ENABLE_CRON=false && nodemon src/server.js",
    "dev:cron": "set NODE_ENV=development && set ENABLE_CRON=true && nodemon src/server.js",
    "server": "nodemon src/server.js",
    "frontend": "cd ../frontend && npm run dev",
    "swagger": "start http://localhost:5000/api-docs",
    "install-all": "npm install && cd ../frontend && npm install",
    "build": "echo Backend ready for production",
    "test": "set NODE_ENV=test && jest tests/",
    "test:watch": "set NODE_ENV=test && jest tests/ --watch",
    "production-check": "node scripts/production-check.js",
    "make-admin": "node scripts/make-admin.js",
    "test-admin": "node scripts/test-admin-flow.js",
    "seed": "node scripts/comprehensive-seed.js",
    "backup": "node scripts/backup-database.js",
    "deploy": "npm run build && npm run production-check"
  },
  "keywords": [
    "elearning",
    "education",
    "api",
    "nodejs",
    "express"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.7.5",
    "stripe": "^14.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.0.1",
    "open-cli": "^8.0.0",
    "supertest": "^7.1.4",
    "wait-on": "^7.2.0"
  }
}
