# =========================
# Production environment template for backend
# IMPORTANT: Do NOT commit real secrets. Replace placeholders and set secrets in your Render (or hosting) environment variables.
# =========================

# Server environment
NODE_ENV=production
# PORT is assigned by the hosting provider (Render). You can optionally set a fallback locally.
# PORT=5000

# Database (set your Atlas/production DB URI in Render secrets)
MONGODB_URI=mongodb+srv://elearnplatform1534_db_user:1EjMGakpkQvOkGuM@elearning.kyyqvl7.mongodb.net/elearning?retryWrites=true&w=majority

# JWT configuration
# Use a strong random secret (>=32 chars). Store in hosting secrets.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=90d

# CORS / Frontend
# Replace with your Vercel frontend URL
CORS_ORIGIN=https://e-learning-five-puce.vercel.app
FRONTEND_URL=https://e-learning-five-puce.vercel.app

# Email Configuration (Resend - Modern & Reliable)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_gpTrJgdY_Bj9QTxg67jCDerUAcSPBdcn1
RESEND_FROM_EMAIL=E-Learning Platform <onboarding@resend.dev>

# Legacy Email Configuration (DEPRECATED - No longer used)
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=

# Payment and callback URLs
# IMPORTANT: replace BACKEND_PUBLIC_URL with the public URL Render gives you (e.g. https://your-app.onrender.com)
BACKEND_PUBLIC_URL=

# VNPay (set values in hosting secrets)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=${FRONTEND_URL}/payment/vnpay/return
# IPN must call your backend public endpoint (set BACKEND_PUBLIC_URL in Render env and update below)
VNPAY_IPN_URL=${BACKEND_PUBLIC_URL}/api/payments/vnpay/ipn

# MoMo (set values in hosting secrets)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
MOMO_RETURN_URL=${FRONTEND_URL}/payment/momo/return
MOMO_IPN_URL=${BACKEND_PUBLIC_URL}/api/payments/momo/ipn

# Stripe keys (put live keys in Render for production)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (Image & Video Storage)
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# File uploads
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,video/mp4,video/webm,video/quicktime

# Rate limiting / logging
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# Other flags
ENABLE_CRON=true
DEBUG_MODE=false
SWAGGER_ENABLED=false

# Notes:
# 1) Set MONGODB_URI, JWT_SECRET, JWT_REFRESH_SECRET, EMAIL_PASSWORD, EMAIL_USER, EMAIL_FROM,
#    BACKEND_PUBLIC_URL, payment secrets (VNPAY/MOMO/Stripe) in Render's environment variables (Dashboard > Environment > Add Secret).
# 2) Ensure server.js / app.js uses `const PORT = process.env.PORT || 5000;` and `app.set('trust proxy', 1);`.
# 3) Do NOT store secrets in the repo.