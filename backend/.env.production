# E-Learning Platform - Production Environment Configuration
# Copy this file to .env and update values for production deployment

# =========================
# SERVER CONFIGURATION
# =========================
PORT=5000
NODE_ENV=production
API_VERSION=v1

# =========================
# DATABASE CONFIGURATION
# =========================
# MongoDB connection string for production
MONGODB_URI=mongodb://localhost:27017/elearning_prod
# Alternative: MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/elearning?retryWrites=true&w=majority

# =========================
# JWT CONFIGURATION
# =========================
# Generate strong secret keys for production
JWT_SECRET=your_super_secure_jwt_secret_key_here_min_32_chars
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_here
JWT_REFRESH_EXPIRE=90d

# =========================
# CORS CONFIGURATION
# =========================
# Your production frontend URL
CORS_ORIGIN=https://yourdomain.com

# =========================
# EMAIL CONFIGURATION
# =========================
# Gmail configuration (recommended for development)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Alternative: SMTP configuration
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your-smtp-password

EMAIL_FROM=noreply@yourdomain.com

# =========================
# FRONTEND URL
# =========================
FRONTEND_URL=https://yourdomain.com

# =========================
# PAYMENT GATEWAYS
# =========================

# VNPay Configuration
VNPAY_TMN_CODE=your_vnpay_terminal_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Production: https://www.vnpay.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://yourdomain.com/payment/vnpay/return
VNPAY_IPN_URL=https://yourdomain.com/api/payments/vnpay/ipn

# MoMo Configuration
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
# Production: https://payment.momo.vn/v2/gateway/api
MOMO_RETURN_URL=https://yourdomain.com/payment/momo/return
MOMO_IPN_URL=https://yourdomain.com/api/payments/momo/ipn

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# For production, use live keys: pk_live_xxx and sk_live_xxx

# =========================
# FILE UPLOAD CONFIGURATION
# =========================
# Maximum file size for uploads (in bytes)
MAX_FILE_SIZE=10485760
# Allowed file types for uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,video/mp4

# Upload storage (local or cloud)
UPLOAD_STORAGE=local
# For cloud storage (AWS S3, Google Cloud, etc.)
# UPLOAD_STORAGE=cloud
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_BUCKET_NAME=your_s3_bucket_name
# AWS_REGION=us-west-2

# =========================
# REDIS CONFIGURATION (Optional)
# =========================
# For caching and session management
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# =========================
# LOGGING CONFIGURATION
# =========================
# Log level: error, warn, info, verbose, debug
LOG_LEVEL=info
# Log file location
LOG_FILE=logs/app.log

# =========================
# SECURITY CONFIGURATION
# =========================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Session secret
SESSION_SECRET=your_super_secure_session_secret_here

# =========================
# CRON JOBS CONFIGURATION
# =========================
# Enable/disable cron jobs
ENABLE_CRON=true

# =========================
# ANALYTICS & MONITORING
# =========================
# Google Analytics (optional)
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Sentry for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# =========================
# THIRD-PARTY INTEGRATIONS
# =========================

# Zoom integration for live classes (optional)
# ZOOM_API_KEY=your_zoom_api_key
# ZOOM_API_SECRET=your_zoom_api_secret

# YouTube API for video processing (optional)
# YOUTUBE_API_KEY=your_youtube_api_key

# =========================
# BACKUP CONFIGURATION
# =========================
# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
# Backup storage location
BACKUP_PATH=./backups
# Or cloud storage
# BACKUP_CLOUD_PROVIDER=aws
# BACKUP_CLOUD_BUCKET=your-backup-bucket

# =========================
# SSL CONFIGURATION
# =========================
# For HTTPS in production
# SSL_KEY_PATH=/path/to/private-key.pem
# SSL_CERT_PATH=/path/to/certificate.pem

# =========================
# DEVELOPMENT SETTINGS
# =========================
# Only for development/testing
DEBUG_MODE=false
SWAGGER_ENABLED=false