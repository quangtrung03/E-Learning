# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/elearning
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/elearning

# JWT Configuration  
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_must_be_32_chars_long
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=your-email@gmail.com

# Frontend URLs (for email links)
FRONTEND_URL=http://localhost:5173
PRODUCTION_URL=https://your-app.vercel.app

# Production Environment Variables
# Set NODE_ENV=production when deploying
# Set MONGODB_URI to your Atlas connection string
# Set JWT_SECRET to a secure 32+ character string
# Set FRONTEND_URL to your Vercel URL
# Set EMAIL_USER and EMAIL_PASSWORD for production Gmail
