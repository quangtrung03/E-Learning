# =========================
# SERVER CONFIGURATION
# =========================
PORT=5000
NODE_ENV=development

# =========================
# DATABASE CONFIGURATION  
# =========================
MONGODB_URI=mongodb://localhost:27017/elearning
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/elearning

# =========================
# JWT CONFIGURATION
# =========================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_must_be_32_chars_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRE=90d

# =========================
# CORS CONFIGURATION
# =========================
CORS_ORIGIN=http://localhost:5173

# =========================
# EMAIL CONFIGURATION
# =========================
# Resend Configuration (Modern & Reliable - Works on Render)
RESEND_API_KEY=re_your_api_key_here_get_from_resend_dashboard
RESEND_FROM_EMAIL=E-Learning Platform <onboarding@resend.dev>

# Note: Use your own verified domain for production
# Example: RESEND_FROM_EMAIL=E-Learning Platform <noreply@yourdomain.com>

# =========================
# FRONTEND URL
# =========================
FRONTEND_URL=http://localhost:5173

# =========================
# CLOUDINARY CONFIGURATION (for image hosting)
# =========================
# Get free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =========================
# PAYMENT GATEWAYS
# =========================
# Bank Transfer (Offline)
BANK_NAME=Vietcombank
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=CONG TY E-LEARNING

# VNPay Configuration
VNPAY_TMN_CODE=your_vnpay_terminal_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:5000/api/payments/vnpay/ipn

# MoMo Configuration
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
MOMO_RETURN_URL=http://localhost:5173/payment/momo/return
MOMO_IPN_URL=http://localhost:5000/api/payments/momo/ipn

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# =========================
# FILE UPLOAD CONFIGURATION
# =========================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,video/mp4

# =========================
# CRON JOBS CONFIGURATION
# =========================
ENABLE_CRON=false

# =========================
# DEVELOPMENT SETTINGS
# =========================
DEBUG_MODE=true
SWAGGER_ENABLED=true

# =========================
# OBSERVABILITY / LOGGING
# =========================
# Set to 'info' to enable structured access logs (JSON)
LOG_LEVEL=

# Optional: Sentry error tracking (backend)
SENTRY_DSN=
